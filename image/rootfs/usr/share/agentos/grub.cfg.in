# AgentOS boot menu. Generated from /usr/share/agentos/grub.cfg.in;
# The root UUID placeholder is filled in at build/install time.
set timeout=3
set default=0
search --no-floppy --fs-uuid --set=root @ROOT_UUID@

menuentry "AgentOS" {
  linux /boot/vmlinuz root=UUID=@ROOT_UUID@ ro quiet splash console=ttyS0,115200 console=tty0
  initrd /boot/initrd.img
}

menuentry "AgentOS（排障模式：不启动图形界面）" {
  linux /boot/vmlinuz root=UUID=@ROOT_UUID@ ro console=ttyS0,115200 console=tty0 agentos.safe=1
  initrd /boot/initrd.img
}

menuentry "UEFI 固件设置" {
  fwsetup
}
