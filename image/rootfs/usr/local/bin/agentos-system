#!/bin/bash
# System actions offered by the agentos-shell system menu. Only these fixed
# actions exist; the shell refuses any other name.
case "${1:-}" in
  terminal)
    exec foot ;;
  setup)
    # Re-run the setup wizard, then restart the task service so it picks up
    # the new planner and keys (its user unit starts it again).
    exec foot --app-id agentos-setup sh -c \
      'sudo /usr/local/bin/agentos-setup; pkill -x -u "$(id -u)" agentos-taskd' ;;
  update)
    # Install the latest AgentOS release (agentos-update restarts the task
    # service; the desktop itself switches over at the next login).
    exec foot --app-id agentos-setup sh -c \
      'sudo /usr/local/bin/agentos-update; read -r -p "按回车关闭" _' ;;
  install)
    exec foot --app-id agentos-setup sh -c \
      'sudo /usr/local/bin/agentos-install; read -r -p "按回车关闭" _' ;;
  reboot)
    exec sudo systemctl reboot ;;
  poweroff)
    exec sudo systemctl poweroff ;;
  *)
    echo "用法：agentos-system terminal|setup|update|install|reboot|poweroff" >&2
    exit 2 ;;
esac
