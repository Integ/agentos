#!/bin/bash
# Boot self-check: prove agentosd and the task service run on this machine
# (offline rule planner, no network or API key needed). The result goes to the journal and to the
# serial console, where the QEMU smoke test looks for it.
console() {
  echo "$*"
  [ -e /dev/ttyS0 ] && timeout 2 sh -c "echo '$*' > /dev/ttyS0" 2>/dev/null || true
}

# Standard input to the journal and, indented, to the serial console: the
# reason for a failure, where the QEMU smoke test can show it.
console_text() {
  local text
  text=$(sed 's/^/  /')
  printf '%s\n' "$text"
  [ -e /dev/ttyS0 ] && printf '%s\n' "$text" | timeout 2 tee /dev/ttyS0 >/dev/null 2>&1 || true
}

out=$(printf '记一下 开机自检\n看看笔记\n' |
  timeout 60 /usr/local/bin/agentosd --planner rule --home /run/agentos-selfcheck --audit /run/agentos-selfcheck.jsonl 2>&1)
if grep -q '开机自检' <<<"$out"; then
  console "AGENTOS-SELFCHECK: OK ($(cat /usr/share/agentos/distro 2>/dev/null) $(cat /usr/share/agentos/version 2>/dev/null), root $(df -h --output=size / | tail -1 | tr -d " "))"
else
  console "AGENTOS-SELFCHECK: FAIL"
  printf '%s\n' "$out"
fi

# Task service: a throwaway agentos-taskd (offline rule planner) carries out
# an intent from the agentos command, and its MCP server answers a registered
# caller with exactly what that caller was given.
taskd_check() {
  local dir=/run/agentos-selfcheck-taskd pid ok=1 mcp
  rm -rf "$dir"
  mkdir -m 0700 "$dir"
  cli() { timeout 60 /usr/local/bin/agentos --state-dir "$dir/state" "$@"; }
  /usr/local/bin/agentos-taskd --planner rule --state-dir "$dir/state" >"$dir/log" 2>&1 &
  pid=$!
  for _ in $(seq 100); do [ -S "$dir/state/control.sock" ] && break; sleep 0.1; done
  cli submit --wait --timeout 30 '记一下 开机自检' >"$dir/submit" 2>&1 || ok=0
  cli caller add selfcheck --name 开机自检 --allow notes.list >/dev/null 2>&1 || ok=0
  mcp=$(printf '%s\n' \
    '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18"}}' \
    '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"read_capability","arguments":{"capability":"notes.list"}}}' \
    '{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"read_capability","arguments":{"capability":"clock.now"}}}' |
    cli mcp --caller selfcheck 2>&1)
  # The note is readable through MCP; a capability it was not given is not.
  grep '"id":2' <<<"$mcp" | grep -q '开机自检' || ok=0
  grep '"id":3' <<<"$mcp" | grep -q '"isError":true' || ok=0
  kill "$pid" 2>/dev/null
  wait "$pid" 2>/dev/null
  if [ "$ok" = 1 ]; then
    console "AGENTOS-TASKD: OK ($(/usr/local/bin/agentos --version 2>/dev/null))"
  else
    console "AGENTOS-TASKD: FAIL"
    cat "$dir/submit" "$dir/log"
    printf '%s\n' "$mcp"
  fi
  rm -rf "$dir"
}
taskd_check

# Plugin sandbox: an unprivileged bubblewrap sandbox can run Python.
if [ "$(runuser -u agent -- bwrap --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp \
       --unshare-all --die-with-parent python3 -c 'print("sandbox-ok")' 2>&1)" = sandbox-ok ]; then
  console "AGENTOS-SANDBOX: OK"
else
  console "AGENTOS-SANDBOX: FAIL"
fi

# Admin: the desktop user can sudo without a password (the setup wizard needs it).
if runuser -u agent -- sudo -n true 2>/dev/null; then
  console "AGENTOS-SUDO: OK"
else
  console "AGENTOS-SUDO: FAIL"
  runuser -u agent -- sudo -n true 2>&1 | head -3
fi

# Recording light: the desktop user can switch the Caps Lock LED (udev rule).
led=$(ls -d /sys/class/leds/*::capslock 2>/dev/null | head -1)
if [ -z "$led" ]; then
  console "AGENTOS-MICLED: NONE"
elif runuser -u agent -- sh -c "echo 1 > '$led/brightness' && echo 0 > '$led/brightness'" 2>/dev/null; then
  console "AGENTOS-MICLED: OK"
else
  console "AGENTOS-MICLED: FAIL"
fi

# Chinese text: a CJK font for the desktop and terminal, and fbterm for the
# text-mode fallback (the bare Linux console cannot draw CJK).
if fc-list :lang=zh family | grep -q 'Noto Sans Mono CJK SC'; then
  console "AGENTOS-CJK: OK (text mode: $(command -v fbterm >/dev/null && echo fbterm || echo 'no fbterm'))"
else
  console "AGENTOS-CJK: FAIL"
fi

# Pinyin: the GTK input-method module that draws fcitx5's candidate window
# in GTK/WebKit apps (agentos-shell) is registered.
if grep -qs 'im-fcitx5.so' /usr/lib/x86_64-linux-gnu/gtk-3.0/3.0.0/immodules.cache; then
  console "AGENTOS-IME: OK"
else
  console "AGENTOS-IME: FAIL"
fi

# Network: NetworkManager brought a connection up and DNS resolves.
if nm-online -q -t 60 && { getent hosts archive.ubuntu.com || getent hosts deb.debian.org; } >/dev/null; then
  console "AGENTOS-NETWORK: OK"
else
  console "AGENTOS-NETWORK: FAIL"
fi

# Graphical desktop: agentos-shell loaded its page and is talking to agentosd
# (it leaves a marker in the session user's runtime dir). Needs a display, so
# a machine without one simply reports a timeout here.
marker=/run/user/$(id -u agent)/agentos-shell.ready
for _ in $(seq 90); do [ -e "$marker" ] && break; sleep 2; done
if [ -e "$marker" ]; then
  console "AGENTOS-DESKTOP: OK ($(cat "$marker"))"
else
  console "AGENTOS-DESKTOP: FAIL"
  journalctl -q -b --no-pager -n 20 -t agentos-shell -t agentosd -t agentos-desktop 2>/dev/null
  tail -n 20 "/run/user/$(id -u agent)/agentos-shell.log" /tmp/agentos-sway.log 2>/dev/null
fi

# The desktop user's own task service: agentos-session starts it at login as
# a user unit, and the agentos command (as that user) reaches it.
state=$(getent passwd agent | cut -d: -f6)/.local/state/agentos
waited=$SECONDS
for _ in $(seq 60); do
  runuser -u agent -- /usr/local/bin/agentos --state-dir "$state" ping >/dev/null 2>&1 && break
  sleep 2
done
if out=$(runuser -u agent -- /usr/local/bin/agentos --state-dir "$state" ping 2>&1); then
  console "AGENTOS-TASKD-SESSION: OK ($out)"
else
  console "AGENTOS-TASKD-SESSION: FAIL (after $((SECONDS - waited)) s)"
  {
    printf '%s\n' "$out"
    loginctl list-sessions --no-legend
    systemctl --machine=agent@.host --user status agentos-taskd.service --no-pager -l
    journalctl -q -b --no-pager -n 30 _SYSTEMD_USER_UNIT=agentos-taskd.service
    journalctl -q -b --no-pager -n 20 -t agentos-taskd -t agentos-session
    ls -la "$state"
  } 2>&1 | console_text
fi

# Crash logging: the desktop's agentosd writes to the journal (agentos-daemon
# runs it under systemd-cat), so its output and any crash report survive.
if journalctl -q -b --no-pager -t agentosd 2>/dev/null | grep -q '管家 Agent 已就绪'; then
  console "AGENTOS-JOURNAL: OK"
else
  console "AGENTOS-JOURNAL: FAIL"
fi

# Test hook, only reachable from a VM: QEMU's
#   -fw_cfg name=opt/agentos/autoinstall,string=/dev/vdb
# asks us to install onto that disk unattended and power off.
modprobe qemu_fw_cfg 2>/dev/null || true
fw=/sys/firmware/qemu_fw_cfg/by_name/opt/agentos/autoinstall/raw
if [ -r "$fw" ] && [ ! -e /etc/agentos/installed ]; then
  target=$(tr -d '\n' < "$fw")
  if /usr/local/bin/agentos-install --yes "$target"; then
    console "AGENTOS-AUTOINSTALL: OK"
  else
    console "AGENTOS-AUTOINSTALL: FAIL"
  fi
  systemctl poweroff
fi
