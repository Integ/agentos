#!/bin/bash
# The AgentOS front door in text mode: the terminal workbench on the task
# service (agentos-taskd, which agentos-session starts with the login), and a
# small menu when it exits (/quit or Ctrl-D).

# In the kiosk the terminal is resized to full screen just after it starts;
# wait for the size to settle so full-screen dialogs are laid out correctly.
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  prev="" n=0
  while [ "$n" -lt 20 ]; do
    cur=$(stty size 2>/dev/null)
    [ -n "$cur" ] && [ "$cur" = "$prev" ] && break
    prev=$cur n=$((n + 1))
    sleep 0.5
  done
fi

if [ ! -f /etc/agentos/setup-done ]; then
  sudo /usr/local/bin/agentos-setup
fi

while true; do
  clear
  # The service may still be starting (or restarting after setup).
  for _ in $(seq 30); do
    /usr/local/bin/agentos ping >/dev/null 2>&1 && break
    sleep 1
  done
  /usr/local/bin/agentos workbench ||
    echo "无法连接任务服务（journalctl --user -u agentos-taskd 查看原因）"
  echo
  echo "────────────────────────────────────────"
  echo " 回车  重新打开管家工作台"
  echo " s     打开命令行（exit 返回）"
  echo " c     重新设置网络和 AI 规划器"
  [ -f /etc/agentos/installed ] || echo " i     安装到这台电脑的硬盘"
  echo " r     重启      p  关机"
  echo "────────────────────────────────────────"
  read -r -p "> " choice || choice=p
  case "$choice" in
    s) AGENTOS_NO_SESSION=1 bash -l ;;
    c) sudo /usr/local/bin/agentos-setup ;;
    i) sudo /usr/local/bin/agentos-install; read -r -p "按回车继续" _ ;;
    r) sudo systemctl reboot ;;
    p) sudo systemctl poweroff ;;
  esac
done
