#!/bin/bash
# The AgentOS desktop inside sway: the full-screen agentos-shell on the task
# service (agentos-taskd, started with the session as a user unit). Falls
# back to the text console if the graphical shell cannot run.
rm -f "$XDG_RUNTIME_DIR/agentos-shell.ready"

# First boot: agentos-shell opens its setup assistant by itself until
# /etc/agentos/setup-done exists (the text console runs agentos-setup).

# Without a GPU render node (simple VM graphics) WebKit's DMA-BUF renderer
# shows a blank window; use shared-memory buffers instead.
ls /dev/dri/renderD* >/dev/null 2>&1 || export WEBKIT_DISABLE_DMABUF_RENDERER=1

# Shell output goes to the journal (journalctl -t agentos-shell).
if command -v systemd-cat >/dev/null; then
  systemd-cat -t agentos-shell --stderr-priority=warning /usr/local/bin/agentos-shell
else
  /usr/local/bin/agentos-shell 2>>"$XDG_RUNTIME_DIR/agentos-shell.log"
fi
status=$?
if [ "$status" -ne 0 ]; then
  echo "agentos-shell 退出（$status），改用文本模式" | systemd-cat -t agentos-desktop -p err 2>/dev/null ||
    echo "agentos-shell 退出（$status），改用文本模式" >>"$XDG_RUNTIME_DIR/agentos-shell.log"
  exec foot --app-id agentos-console /usr/local/bin/agentos-console
fi
swaymsg exit
