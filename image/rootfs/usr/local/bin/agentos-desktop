#!/bin/bash
# The AgentOS desktop inside sway: agentosd on a Unix socket plus the
# full-screen agentos-shell. Falls back to the text console if the graphical
# shell cannot run.
#
# With AGENTOS_DESKTOP=taskd in /etc/agentos/agentos.env the desktop talks to
# the task service (agentos-taskd, started with the session) instead: threads,
# questions and the rest of v0.4, but no push-to-talk voice yet.
export AGENTOS_SOCKET="$XDG_RUNTIME_DIR/agentos.sock"
rm -f "$XDG_RUNTIME_DIR/agentos-shell.ready"

ENV_FILE=/etc/agentos/agentos.env
desktop=$( [ -r "$ENV_FILE" ] && . "$ENV_FILE" >/dev/null 2>&1; printf '%s' "${AGENTOS_DESKTOP:-}" )

if [ "$desktop" = taskd ]; then
  shell_args=(--taskd)
  stop_daemon() { :; }
else
  shell_args=()
  /usr/local/bin/agentos-daemon &
  daemon=$!
  stop_daemon() { kill "$daemon" 2>/dev/null; pkill -x -u "$(id -u)" agentosd; }
fi

# First boot: agentos-shell opens its setup assistant by itself until
# /etc/agentos/setup-done exists (the text console runs agentos-setup).

# Without a GPU render node (simple VM graphics) WebKit's DMA-BUF renderer
# shows a blank window; use shared-memory buffers instead.
ls /dev/dri/renderD* >/dev/null 2>&1 || export WEBKIT_DISABLE_DMABUF_RENDERER=1

# Shell output goes to the journal (journalctl -t agentos-shell).
if command -v systemd-cat >/dev/null; then
  systemd-cat -t agentos-shell --stderr-priority=warning /usr/local/bin/agentos-shell "${shell_args[@]}"
else
  /usr/local/bin/agentos-shell "${shell_args[@]}" 2>>"$XDG_RUNTIME_DIR/agentos-shell.log"
fi
status=$?
stop_daemon
if [ "$status" -ne 0 ]; then
  echo "agentos-shell 退出（$status），改用文本模式" | systemd-cat -t agentos-desktop -p err 2>/dev/null ||
    echo "agentos-shell 退出（$status），改用文本模式" >>"$XDG_RUNTIME_DIR/agentos-shell.log"
  exec foot --app-id agentos-console /usr/local/bin/agentos-console
fi
swaymsg exit
