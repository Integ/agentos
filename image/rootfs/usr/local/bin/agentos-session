#!/bin/bash
# tty1 autologin → sway → AgentOS desktop (agentosd + agentos-shell).
# Falls back to the plain text console if the graphical session can't start.

# The task service runs for as long as the user is logged in, in text mode
# too. It is started rather than enabled: an update bundle can add the unit,
# but not the symlink that enabling needs. A unit added by an update while the
# user manager kept running is only seen after a reload.
# A failure is logged (journalctl -t agentos-session), never fatal: the
# desktop does not depend on the task service.
if command -v systemctl >/dev/null && [ -x /usr/local/bin/agentos-taskd ]; then
  systemctl --user cat agentos-taskd.service >/dev/null 2>&1 || systemctl --user daemon-reload 2>/dev/null
  if ! err=$(systemctl --user --no-block start agentos-taskd.service 2>&1); then
    printf '无法启动任务服务：%s\n' "$err" | systemd-cat -t agentos-session -p warning 2>/dev/null
  fi
fi

# The Linux console has no CJK glyphs: run the (Chinese) text console inside
# fbterm, which draws with the system fonts on the framebuffer.
text_console() {
  if [ "${TERM:-}" = linux ] && command -v fbterm >/dev/null && [ -w /dev/fb0 ]; then
    exec fbterm --font-names="Noto Sans Mono CJK SC" --font-size=18 -- /usr/local/bin/agentos-console
  fi
  exec /usr/local/bin/agentos-console
}

if grep -qw 'agentos.safe=1' /proc/cmdline || ! command -v sway >/dev/null; then
  text_console
fi

# Autologin can win the race against the GPU driver (slow USB disks, firmware
# loading): give the display device a few seconds to appear.
for _ in $(seq 20); do
  ls /dev/dri/card* >/dev/null 2>&1 && break
  sleep 0.5
done

export XDG_CURRENT_DESKTOP=sway XDG_SESSION_TYPE=wayland
export XMODIFIERS=@im=fcitx QT_IM_MODULE=fcitx GTK_IM_MODULE=fcitx
# Allow llvmpipe on machines without a usable GPU driver; without any render
# node at all (simple VM graphics) use wlroots' pure-CPU renderer.
export WLR_RENDERER_ALLOW_SOFTWARE=1
ls /dev/dri/renderD* >/dev/null 2>&1 || export WLR_RENDERER=pixman
export WLR_NO_HARDWARE_CURSORS=1

log=/tmp/agentos-sway.log
# If the GPU is present but unusable (e.g. missing firmware leaves the Intel
# GPU wedged), retry once with wlroots' pure-CPU renderer before giving up.
if ! sway --config /usr/share/agentos/sway.conf >"$log" 2>&1 &&
   ! { [ "${WLR_RENDERER:-}" != pixman ] &&
       WLR_RENDERER=pixman WEBKIT_DISABLE_DMABUF_RENDERER=1 \
         sway --config /usr/share/agentos/sway.conf >>"$log" 2>&1; }; then
  # Keep the reason after a reboot: journalctl -t agentos-sway
  command -v systemd-cat >/dev/null && tail -n 40 "$log" | systemd-cat -t agentos-sway -p err
  echo "Graphical session failed (journalctl -t agentos-sway); using text mode."
  echo "图形界面启动失败（日志：journalctl -t agentos-sway），改用文本模式。"
  sleep 3
  text_console
fi
