#!/bin/bash
# Update the AgentOS layer (agentos-taskd, agentos, agentos-shell,
# agentos-web-shell, the agentos-* scripts and their systemd/udev files) from
# a GitHub release, with a health check before anything is replaced and
# one-step rollback.
#
#   sudo agentos-update              # install the latest release
#   agentos-update --check           # only report whether one is available
#   sudo agentos-update --to v0.2.2  # install a specific release
#   sudo agentos-update --file agentos-update-x86_64.tar.gz   # offline
#   sudo agentos-update --rollback   # put the previous version back
#   sudo agentos-update --system     # also apt full-upgrade the base system
#
# Only files under usr/, etc/systemd/system/agentos-* and
# etc/udev/rules.d/*agentos* are accepted from a bundle. User settings
# (/etc/agentos, the data directory) are never touched.
#
# Environment (mostly for tests):
#   AGENTOS_UPDATE_REPO  owner/name on GitHub        (default Integ/agentos)
#   AGENTOS_UPDATE_API   GitHub API base URL         (default https://api.github.com)
#   AGENTOS_UPDATE_ROOT  install root                (default /)
set -euo pipefail

REPO="${AGENTOS_UPDATE_REPO:-Integ/agentos}"
API="${AGENTOS_UPDATE_API:-https://api.github.com}"
ROOT="${AGENTOS_UPDATE_ROOT:-/}"
ROOT="${ROOT%/}"
ASSET=agentos-update-x86_64.tar.gz
STATE="$ROOT/var/lib/agentos-update"
RELEASE_FILE="$ROOT/usr/share/agentos/release"
ROLLBACK="$STATE/rollback"
PENDING="$STATE/pending"
UPDATER=usr/local/bin/agentos-update

die() { echo "agentos-update: $*" >&2; exit 1; }
say() { echo "==> $*"; }

usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

mode=install target="" file="" system=0 force=0
while [ $# -gt 0 ]; do
  case "$1" in
    --check) mode=check ;;
    --rollback) mode=rollback ;;
    --to) target="${2:?--to 需要版本号}"; shift ;;
    --file) file="${2:?--file 需要文件路径}"; shift ;;
    --system) system=1 ;;
    --force) force=1 ;;
    -h|--help) usage 0 ;;
    *) echo "未知参数：$1" >&2; usage 2 ;;
  esac
  shift
done

need_root() {
  if [ -z "$ROOT" ] && [ "$(id -u)" -ne 0 ]; then
    die "需要 root 权限，请用 sudo 运行"
  fi
}

# Print "tag<TAB>bundle-url<TAB>sha256-url" for the requested release.
release_info() {
  local url
  if [ -n "$target" ]; then
    url="$API/repos/$REPO/releases/tags/$target"
  else
    url="$API/repos/$REPO/releases/latest"
  fi
  curl -fsSL --retry 3 --max-time 30 -H 'Accept: application/vnd.github+json' "$url" |
    python3 -c '
import json, sys
r = json.load(sys.stdin)
assets = {a["name"]: a["browser_download_url"] for a in r.get("assets", [])}
name = sys.argv[1]
if name not in assets or name + ".sha256" not in assets:
    sys.exit("release %s has no %s" % (r.get("tag_name"), name))
print(r["tag_name"], assets[name], assets[name + ".sha256"], sep="\t")
' "$ASSET"
}

# Services that pick up new files: systemd units, udev rules, the task
# service (its user unit restarts agentos-taskd, which first marks unfinished
# tasks interrupted). The shell needs a new session. An agentosd left running
# by a desktop session from before the merge is stopped too; until the next
# login that session finds only the stand-in, which waits quietly.
reload() {
  [ -z "$ROOT" ] || return 0
  systemctl daemon-reload 2>/dev/null || true
  udevadm control --reload 2>/dev/null || true
  pkill -x agentosd 2>/dev/null || true
  pkill -x agentos-taskd 2>/dev/null || true
}

# Accept only the paths AgentOS owns; reject links, devices and the like.
check_tree() {
  local dir="$1" bad
  bad=$(cd "$dir" && find . -mindepth 1 \( ! -type f ! -type d \) -print -quit)
  [ -z "$bad" ] || die "更新包里有不允许的文件类型：$bad"
  bad=$(cd "$dir" && find . -type f | sed 's|^\./||' | grep -Ev \
    '^(usr/.+|etc/systemd/system/agentos-[^/]+|etc/udev/rules\.d/[^/]*agentos[^/]*)$' | head -1 || true)
  [ -z "$bad" ] || die "更新包里有不允许的路径：$bad"
  [ -x "$dir/usr/local/bin/agentos-taskd" ] || die "更新包里没有 agentos-taskd"
  [ -s "$dir/usr/share/agentos/release" ] || die "更新包里没有版本号"
}

# The new task service must accept an intent from the new `agentos` command
# and carry it out with the offline rule planner before it replaces the
# running one.
health_check() {
  local dir="$1" tmp pid out status=0
  [ -x "$dir/usr/local/bin/agentos" ] || die "更新包里有 agentos-taskd 却没有 agentos 命令"
  tmp=$(mktemp -d)
  # No model, no judge: whatever keys this shell has must not be used.
  env -u ANTHROPIC_API_KEY -u OPENAI_API_KEY -u OPENAI_BASE_URL -u AGENTOS_PLANNER -u AGENTOS_JUDGE \
    "$dir/usr/local/bin/agentos-taskd" --planner rule --state-dir "$tmp/state" 9>&- >"$tmp/log" 2>&1 &
  pid=$!
  for _ in $(seq 100); do [ -S "$tmp/state/control.sock" ] && break; sleep 0.1; done
  out=$(timeout 60 "$dir/usr/local/bin/agentos" --state-dir "$tmp/state" \
    submit --wait --timeout 30 '记一下 更新自检' 2>&1) || status=$?
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  if [ "$status" -ne 0 ] || ! grep -q '更新自检' <<<"$out"; then
    { printf '%s\n' "$out"; tail -20 "$tmp/log"; } | tail -30 >&2
    rm -rf "$tmp"
    die "新版本的任务服务自检失败，未做任何改动"
  fi
  rm -rf "$tmp"
}

# Write next to the target, then rename, so a running binary is never
# half-written. Swap the updater itself after the rest of the payload.
install_file() {
  local dir="$1" f="$2" dest="$ROOT/$2"
  mkdir -p "$(dirname "$dest")"
  cp -p "$dir/$f" "$dest.agentos-new"
  mv -f "$dest.agentos-new" "$dest"
}

install_tree() {
  local dir="$1" f
  (cd "$dir" && find . -type f | sed 's|^\./||') | while IFS= read -r f; do
    if [ "$f" != "$UPDATER" ]; then
      install_file "$dir" "$f"
    fi
  done
}

restore_pending() {
  local f remove_updater=0
  [ -d "$PENDING/files" ] && [ -f "$PENDING/new-files" ] || die "无法读取未完成更新的备份"
  say "恢复到 $(cat "$PENDING/release" 2>/dev/null || echo unknown)"
  install_tree "$PENDING/files"
  while IFS= read -r f; do
    if [ "$f" = "$UPDATER" ]; then
      remove_updater=1
    else
      rm -f "$ROOT/$f" "$ROOT/$f.agentos-new"
    fi
  done <"$PENDING/new-files"
  # Leave a recovery-aware updater in place until the payload is restored
  # and durable, including when the old release has no such updater.
  sync
  reload
  if [ -f "$PENDING/files/$UPDATER" ]; then
    install_file "$PENDING/files" "$UPDATER"
  elif [ "$remove_updater" -eq 1 ]; then
    rm -f "$ROOT/$UPDATER" "$ROOT/$UPDATER.agentos-new"
  fi
  sync

  # An interrupted commit may have moved the earlier rollback here.
  if [ -d "$PENDING/previous" ]; then
    mv "$PENDING/previous" "$ROLLBACK"
    sync
  fi
  # The restore can be retried until this rename. Never delete the live
  # backup in place, since removal could leave a half-deleted transaction.
  mv "$PENDING" "$work/restored"
  sync
  say "已恢复。重新登录（或重启）后桌面也会用回旧版本。"
}

system_upgrade() {
  [ -z "$ROOT" ] || { say "跳过系统升级（AGENTOS_UPDATE_ROOT 不是 /）"; return 0; }
  say "升级基础系统（apt）"
  DEBIAN_FRONTEND=noninteractive apt-get update -q
  DEBIAN_FRONTEND=noninteractive apt-get -y -q \
    -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold full-upgrade
}

if [ "$mode" = check ]; then
  [ ! -d "$PENDING" ] || die "有未完成的更新或回滚，请运行 sudo agentos-update --rollback 恢复"
  current=$(cat "$RELEASE_FILE" 2>/dev/null || echo unknown)
  info=$(release_info) || die "查不到发布信息（网络或 GitHub 不可用）"
  latest=${info%%$'\t'*}
  if [ "$latest" = "$current" ]; then
    echo "已是最新版本：$current"
  else
    echo "有新版本：$latest（当前 $current）"
    echo "安装：sudo agentos-update"
  fi
  exit 0
fi

need_root
mkdir -p "$STATE"
chmod 0700 "$STATE"
exec 9>"$STATE/update.lock"
flock -x 9
# A killed process cannot run its EXIT trap. The lock ensures no live update
# is using these directories, and the recovery backup lives outside them.
rm -rf "$STATE"/work.*
work=$(mktemp -d "$STATE/work.XXXXXX")
trap 'rm -rf "$work"' EXIT

if [ -d "$PENDING" ]; then
  restore_pending
  if [ "$mode" = rollback ]; then exit 0; fi
fi
# A committed install may have stopped before removing the older backup.
rm -rf "$ROLLBACK/previous"
if [ "$mode" = rollback ]; then
  [ -d "$ROLLBACK/files" ] || die "没有可回滚的版本"
  mv "$ROLLBACK" "$PENDING"
  sync
  restore_pending
  exit 0
fi
current=$(cat "$RELEASE_FILE" 2>/dev/null || echo unknown)

if [ -n "$file" ]; then
  [ -r "$file" ] || die "读不到 $file"
  [ -r "$file.sha256" ] || die "缺少校验文件 $file.sha256"
  cp "$file" "$work/$ASSET"
  cp "$file.sha256" "$work/$ASSET.sha256"
else
  info=$(release_info) || die "查不到发布信息（网络或 GitHub 不可用）"
  IFS=$'\t' read -r latest bundle_url sum_url <<<"$info"
  if [ "$latest" = "$current" ] && [ "$force" -eq 0 ]; then
    say "AgentOS 已是最新版本：$current"
    [ "$system" -eq 1 ] && system_upgrade
    exit 0
  fi
  say "下载 $latest"
  curl -fsSL --retry 3 --max-time 600 -o "$work/$ASSET" "$bundle_url"
  curl -fsSL --retry 3 --max-time 60 -o "$work/$ASSET.sha256" "$sum_url"
fi

want=$(awk '{print $1; exit}' "$work/$ASSET.sha256")
got=$(sha256sum "$work/$ASSET" | awk '{print $1}')
[ -n "$want" ] && [ "$want" = "$got" ] || die "校验失败（sha256 不匹配），未做任何改动"

mkdir "$work/new"
tar --no-same-owner --no-same-permissions -xzf "$work/$ASSET" -C "$work/new"
# Keep the executable bits from the bundle, but nothing setuid.
chmod -R u+rwX,go+rX,go-w,ug-s "$work/new"
check_tree "$work/new"
new=$(cat "$work/new/usr/share/agentos/release")
say "自检新版本 $new"
health_check "$work/new"

# Back up what is about to be replaced, then swap the files in.
back="$work/rollback"
mkdir -p "$back/files"
: >"$back/new-files"
(cd "$work/new" && find . -type f | sed 's|^\./||') | while IFS= read -r f; do
  if [ -e "$ROOT/$f" ]; then
    mkdir -p "$back/files/$(dirname "$f")"
    cp -p "$ROOT/$f" "$back/files/$f"
  else
    echo "$f" >>"$back/new-files"
  fi
done
echo "$current" >"$back/release"
# Publish and flush the backup before changing the first installed file.
sync
mv "$back" "$PENDING"
sync

say "安装 $new"
install_tree "$work/new"
sync
if [ -f "$work/new/$UPDATER" ]; then
  install_file "$work/new" "$UPDATER"
fi
sync

# Moving the backup into rollback commits the install. Keep the earlier
# rollback recoverable until that rename is durable.
if [ -d "$ROLLBACK" ]; then
  mv "$ROLLBACK" "$PENDING/previous"
  sync
fi
mv "$PENDING" "$ROLLBACK"
sync
rm -rf "$ROLLBACK/previous"
reload
say "已更新到 $new（之前是 $current）。重新登录（或重启）后桌面也会用上新版本；有问题可以 sudo agentos-update --rollback。"

[ "$system" -eq 1 ] && system_upgrade
exit 0
